generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CLIENT_READONLY
}

enum Jurisdiction {
  DTCP
  TOWN_PANCHAYAT
  PANCHAYAT_UNION
}

enum ApprovalType {
  LAYOUT_APPROVAL
  BUILDING_PLAN_APPROVAL
  COMPLETION_CERTIFICATE
  PATTA_TRANSFER
}

enum CaseStatus {
  INTAKE
  DOCUMENT_COLLECTION
  APPLICATION_PREP
  SUBMITTED
  SCRUTINY
  ACTION_NEEDED
  INSPECTION_SCHEDULED
  INSPECTION_DONE
  APPROVED
  CLOSED
}

enum DocumentType {
  SALE_DEED
  ID_PROOF
  SITE_PLAN
  BUILDING_PLAN
  EC
  PATTA
  CHITTA
  TSLR
  TAX_RECEIPT
  NOC_FIRE
  NOC_TRAFFIC
  OTHER
}

enum FeeType {
  SCRUTINY
  CENTAGE
  DEVELOPMENT_CHARGE
  SERVICE_FEE
}

model User {
  id             String          @id @default(uuid())
  name           String
  phone          String          @unique
  email          String?         @unique
  role           Role
  password_hash  String
  
  assignedCases  Case[]          @relation("AssignedStaff")
  statusChanges  StatusHistory[] @relation("ChangedBy")
}

model Property {
  id            String       @id @default(uuid())
  owner_name    String
  owner_phone   String
  address       String
  village       String
  taluk         String
  survey_number String
  jurisdiction  Jurisdiction
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  cases         Case[]
}

model Case {
  id                 String       @id @default(uuid())
  property_id        String
  parent_case_id     String?
  approval_type      ApprovalType
  status             CaseStatus   @default(INTAKE)
  application_number String?
  approval_number    String?
  assigned_staff_id  String?
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  property           Property     @relation(fields: [property_id], references: [id])
  parent_case        Case?        @relation("ParentChildCase", fields: [parent_case_id], references: [id])
  child_cases        Case[]       @relation("ParentChildCase")
  assigned_staff     User?        @relation("AssignedStaff", fields: [assigned_staff_id], references: [id])

  status_history     StatusHistory[]
  documents          Document[]
  fees               Fee[]
}

model StatusHistory {
  id         String     @id @default(uuid())
  case_id    String
  from_status CaseStatus
  to_status   CaseStatus
  changed_by String
  note       String?
  changed_at DateTime   @default(now())

  case       Case       @relation(fields: [case_id], references: [id])
  user       User       @relation("ChangedBy", fields: [changed_by], references: [id])
}

model Document {
  id            String       @id @default(uuid())
  case_id       String
  document_type DocumentType
  file_key      String
  version       Int          @default(1)
  uploaded_by   String
  verified      Boolean      @default(false)
  uploaded_at   DateTime     @default(now())

  case          Case         @relation(fields: [case_id], references: [id])
  
  // Inverse relation for fee receipts
  fee_receipts  Fee[]        @relation("ReceiptDocument")
}

model ChecklistTemplate {
  id                       String         @id @default(uuid())
  approval_type            ApprovalType
  jurisdiction             Jurisdiction
  required_document_types  DocumentType[]

  @@unique([approval_type, jurisdiction])
}

model Fee {
  id                  String   @id @default(uuid())
  case_id             String
  fee_type            FeeType
  amount              Float
  paid                Boolean  @default(false)
  receipt_document_id String?
  created_at          DateTime @default(now())

  case                Case     @relation(fields: [case_id], references: [id])
  receipt_document    Document? @relation("ReceiptDocument", fields: [receipt_document_id], references: [id])
}
